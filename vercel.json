{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "alias": ["orangegroup.vercel.app"],
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "compass-theme.css", "use": "@vercel/static" },
    { "src": "bus-banner.css", "use": "@vercel/static" },
    { "src": "config.js", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "orangesoft-logo.svg", "use": "@vercel/static" },
    { "src": "orangegroup-hero.jpg", "use": "@vercel/static" },
    { "src": "destination-krakow.jpg", "use": "@vercel/static" },
    { "src": "destination-berlin.jpg", "use": "@vercel/static" },
    { "src": "destination-munich.jpg", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
